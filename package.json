{
  "name": "connect-four",
  "version": "1.0.0",
  "description": "A two-player Connect Four game in the browser, played through a REST API on a Cloudflare Worker.",
  "main": "index.js",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "lint": "pnpm run lint:js && pnpm run lint:api",
    "lint:js": "eslint . --max-warnings 0",
    "lint:api": "redocly lint",
    "test": "vitest run",
    "prepare": "husky || true"
  },
  "author": "Issoufi ADAM <issoufi.adam1@gmail.com>",
  "license": "ISC",
  "dependencies": {
    "express": "^5.3.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@commitlint/lint": "^21.2.3",
    "@commitlint/load": "^21.2.3",
    "@eslint/js": "^10.0.1",
    "@redocly/cli": "^2.64.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "vitest": "^5.0.5",
    "wrangler": "^4.151.1"
  },
  "engines": {
    "node": "^22.13.0 || ^24.0.0 || >=26.0.0"
  },
  "packageManager": "pnpm@12.14.0"
}
