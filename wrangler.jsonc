{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "connect-four",
  "main": "index.js",
  "compatibility_date": "2026-10-01",
  // Lets Express run on the Worker, with `httpServerHandler` of `cloudflare:node`.
  "compatibility_flags": ["nodejs_compat"],
  // The page, its script and the API docs, served before the Worker runs.
  "assets": {
    "directory": "public"
  },
  "durable_objects": {
    "bindings": [{ "name": "GAMES", "class_name": "Game" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Game"] }],
  // Limits the games that one client network (an IPv4 address or an IPv6 /64 prefix) starts
  // with `POST /game`, per minute.
  "ratelimits": [
    {
      "name": "GAME_START_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 20, "period": 60 }
    }
  ],
  "routes": [{ "pattern": "connect-four.issoufi.fr", "custom_domain": true }],
  // Serves each branch Preview on workers.dev. It also turns on the Version URLs of production
  // versions there, which run with the production games and rate limit, like the site.
  "preview_urls": true,
  "observability": {
    "enabled": true
  },
  // What `wrangler preview` gives a branch Preview, which inherits none of the bindings above.
  // Each Preview gets its own Durable Object storage, so it never reads the production games.
  "previews": {
    "durable_objects": {
      "bindings": [{ "name": "GAMES", "class_name": "Game" }]
    },
    // A namespace apart from production, whose counters all the Previews share.
    "ratelimits": [
      {
        "name": "GAME_START_LIMITER",
        "namespace_id": "1002",
        "simple": { "limit": 20, "period": 60 }
      }
    ],
    "observability": {
      "enabled": true
    }
  }
}
